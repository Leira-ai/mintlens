# MintLens environment — copy to `.env` (or export directly) and fill in
# your own key. `.env` is gitignored; NEVER commit a real key.
#
# The deterministic core (mintlens.py) and the smoke test need NO key at
# all — they only read public BSC RPCs, Sourcify, and DexScreener.
# A key is only needed for the model-backed agent (agent.py).

# The OpenMinion runtime reads the provider key from this environment
# variable (it is the `api_key_env` of the `openai` provider slot in
# .openminion/agents.json). MintLens was developed with a Gemini key
# through Google's OpenAI-compatible endpoint (base_url
# https://generativelanguage.googleapis.com/v1beta/openai/ ,
# model gemini-3.1-flash-lite — see FINDINGS #7/#8); any
# OpenAI-compatible provider key works with matching config.
OPENAI_API_KEY=your-provider-api-key-here

# Alternative key source used by the operator's setup: if OPENAI_API_KEY
# is unset, agent.py falls back to reading the key from a local file
# (first line, whitespace-trimmed):
#   .openminion/gemini.key        (chmod 600, gitignored — create it with:
#                                  printf '%s' "your-key" > .openminion/gemini.key)
# With no key in either place, agent.py does NOT crash: it prints that
# the model layer is skipped and runs the deterministic brief instead.

# Optional, only on hosts whose NO_PROXY contains bracketed IPv6 entries
# (e.g. "[::1]") — those crash httpx before any request (FINDINGS #12).
# agent.py sanitizes this automatically; the equivalent manual setting:
# NO_PROXY=localhost,127.0.0.1
